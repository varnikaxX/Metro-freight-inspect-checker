# Maximum number of images accepted in a single scan request
MAX_IMAGES=5

# Timeout in seconds applied to each image download
IMAGE_DOWNLOAD_TIMEOUT=15

# Maximum allowed size (in MB) for a single downloaded image
MAX_IMAGE_SIZE_MB=10

# Path to your Google Cloud service account credentials JSON file.
# The official Google client library reads this variable itself.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
