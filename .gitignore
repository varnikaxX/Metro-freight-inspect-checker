# ==========================================
# Environment variables and private secrets
# ==========================================
.env
.env.*
!.env.example
backend/.env
frontend/.env.local

# ==========================================
# Google Cloud / service-account credentials
# Never commit these
# ==========================================
*service-account*.json
*credential*.json
*credentials*.json
gcp-key.json
vision-key.json
metro-verify-vision.json
backend/gcp-vision-credentials.json
backend/google-credentials.json
backend/service-account.json

