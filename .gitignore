# ==========================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.Python
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# Python virtual environments
# ==========================================
.venv/
venv/
env/
backend/venv/
backend/**/__pycache__/

